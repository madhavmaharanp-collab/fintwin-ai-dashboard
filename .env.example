# Copy locally and fill in the values. Never commit actual credentials.
# Runtime transaction pooler and session pooler for Drizzle schema operations.
# Percent-encode special characters in the password.
DATABASE_URL=your-supabase-database-url
DIRECT_URL=your-supabase-direct-database-url

# Backend Supabase Auth configuration (publishable key, not a secret key).
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key


# Vite browser configuration; these values are public in the browser bundle.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server only.
GEMINI_API_KEY=your-gemini-api-key
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Expo development values (public; never put secrets in EXPO_PUBLIC variables).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your-current-clerk-publishable-key
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000
